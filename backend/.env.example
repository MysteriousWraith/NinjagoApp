# Получи на https://my.telegram.org (API development tools)
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# Создай бота через @BotFather и добавь его АДМИНОМ в свой закрытый канал
TG_BOT_TOKEN=123456:ABC-DEF_bot_token

# ID твоего закрытого канала (из ссылки https://t.me/c/4438841209/3 -> -1004438841209)
TG_CHANNEL_ID=-1004438841209

# Секретный ключ, который должен совпадать с AppConfig.BACKEND_API_KEY в Android
APP_API_KEY=ninjago_ua_secret_2026
